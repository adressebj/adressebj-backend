# Base de données
DATABASE_URL=postgresql://user:password@localhost:5432/adressebj?schema=public

# JWT
JWT_SECRET=change-me
JWT_EXPIRES_IN=7d

# Africa's Talking (OTP SMS)
AT_USERNAME=
AT_API_KEY=
AT_SENDER_ID=AdresseBJ

# Cloudinary (upload photos)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# App
NODE_ENV=development
PORT=3000
ALLOWED_ORIGINS=http://localhost:5173

# Rattachement localisation (mètres)
LOCALISATION_RADIUS_METERS=15

# Routage / ETA (OSRM) — valeurs par défaut si non renseignées.
# OSRM public ne nécessite aucune clé ; repli local gracieux si indisponible.
OSRM_BASE_URL=https://router.project-osrm.org
OSRM_TIMEOUT_MS=3000
ROUTING_FALLBACK_SPEED_KMH=25

# Web Push (VAPID) — générer avec: npx web-push generate-vapid-keys
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
