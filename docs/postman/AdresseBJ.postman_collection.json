{
  "info": {
    "_postman_id": "91a8c9b3-6cf4-4cad-ae7f-ffda05300a94",
    "name": "AdresseBJ — Backend API",
    "description": "Collection vivante de l'API AdresseBJ. À maintenir en synchro stricte avec l'API réelle (cf. docs/API_POSTMAN.md). Variables d'environnement : baseUrl, jwt, jwtMod, apiKey. Variables de collection : addressCode, revisionId (auto-capturées).",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "Auth",
      "item": [
        {
          "name": "Request OTP",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"phone\": \"+22990000000\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": {
              "raw": "{{baseUrl}}/auth/request-otp",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "auth",
                "request-otp"
              ]
            },
            "description": "Envoie un OTP au numéro (provider dev : code visible dans les logs serveur)."
          }
        },
        {
          "name": "Register",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"phone\": \"+22990000000\",\n  \"code\": \"123456\",\n  \"email\": \"habitant@example.com\",\n  \"password\": \"motdepasse123\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": {
              "raw": "{{baseUrl}}/auth/register",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "auth",
                "register"
              ]
            },
            "description": "Crée l'habitant après vérification de l'OTP. Capture {{jwt}}."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const d = pm.response.json().data;",
                  "if (d && d.token) pm.environment.set('jwt', d.token);",
                  "pm.test('token reçu', () => pm.expect(d.token).to.be.a('string'));"
                ]
              }
            }
          ]
        },
        {
          "name": "Login (habitant)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"phone\": \"+22990000000\",\n  \"password\": \"motdepasse123\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": {
              "raw": "{{baseUrl}}/auth/login",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "auth",
                "login"
              ]
            },
            "description": "Connexion par téléphone OU email (un seul des deux). Capture {{jwt}}."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const d = pm.response.json().data;",
                  "if (d && d.token) pm.environment.set('jwt', d.token);"
                ]
              }
            }
          ]
        },
        {
          "name": "Login (modérateur)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"moderateur@example.com\",\n  \"password\": \"motdepasse123\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": {
              "raw": "{{baseUrl}}/auth/login",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "auth",
                "login"
              ]
            },
            "description": "Connexion modérateur/admin par email. Capture {{jwtMod}}."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const d = pm.response.json().data;",
                  "if (d && d.token) pm.environment.set('jwtMod', d.token);"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "Addresses",
      "item": [
        {
          "name": "Create address",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"category\": \"COMMERCE\",\n  \"steps\": [\n    \"Partir du carrefour\",\n    \"Boutique verte\"\n  ],\n  \"photoUrl\": \"https://res.cloudinary.com/demo/image/upload/sample.jpg\",\n  \"gpsLat\": 6.4001,\n  \"gpsLng\": 2.4001\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{jwt}}",
                  "type": "string"
                }
              ]
            },
            "url": {
              "raw": "{{baseUrl}}/addresses",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "addresses"
              ]
            },
            "description": "localisationId résolu côté serveur (jamais envoyé par le client). Capture {{addressCode}}."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const d = pm.response.json().data;",
                  "if (d && d.code) pm.collectionVariables.set('addressCode', d.code);",
                  "pm.test('révision n°1 en attente', () => pm.expect(d.revisionStatus).to.eql('EN_ATTENTE_VALIDATION'));"
                ]
              }
            }
          ]
        },
        {
          "name": "My addresses",
          "request": {
            "method": "GET",
            "header": [],
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{jwt}}",
                  "type": "string"
                }
              ]
            },
            "url": {
              "raw": "{{baseUrl}}/addresses/mine",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "addresses",
                "mine"
              ]
            },
            "description": "Liste les adresses de l'habitant connecté + leur état (published, statut de révision)."
          }
        },
        {
          "name": "Public page",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/addresses/{{addressCode}}",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "addresses",
                "{{addressCode}}"
              ]
            },
            "description": "Public, sans auth. 200 si publiée, 404 si jamais publiée/inexistante, 410 si désactivée."
          }
        },
        {
          "name": "Resolve (clé API)",
          "request": {
            "method": "GET",
            "header": [],
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{apiKey}}",
                  "type": "string"
                }
              ]
            },
            "url": {
              "raw": "{{baseUrl}}/addresses/{{addressCode}}/resolve",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "addresses",
                "{{addressCode}}",
                "resolve"
              ]
            },
            "description": "Header Authorization: Bearer {{apiKey}} (bj_live_…). Résolution complète + métering. 401 si clé absente/invalide/révoquée/expirée."
          }
        }
      ]
    },
    {
      "name": "Moderation",
      "item": [
        {
          "name": "List pending revisions",
          "request": {
            "method": "GET",
            "header": [],
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{jwtMod}}",
                  "type": "string"
                }
              ]
            },
            "url": {
              "raw": "{{baseUrl}}/moderation/revisions",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "moderation",
                "revisions"
              ]
            },
            "description": "File des révisions EN_ATTENTE_VALIDATION (Mod/Admin). Capture {{revisionId}} (1re entrée)."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const d = pm.response.json().data;",
                  "if (Array.isArray(d) && d.length) pm.collectionVariables.set('revisionId', d[0].id);"
                ]
              }
            }
          ]
        },
        {
          "name": "Approve revision",
          "request": {
            "method": "PATCH",
            "header": [],
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{jwtMod}}",
                  "type": "string"
                }
              ]
            },
            "url": {
              "raw": "{{baseUrl}}/moderation/revisions/{{revisionId}}/approve",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "moderation",
                "revisions",
                "{{revisionId}}",
                "approve"
              ]
            },
            "description": "Publie la révision et bascule le pointeur. L'ancienne version publiée passe ARCHIVEE."
          }
        },
        {
          "name": "Reject revision",
          "request": {
            "method": "PATCH",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"reason\": \"Photo illisible\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{jwtMod}}",
                  "type": "string"
                }
              ]
            },
            "url": {
              "raw": "{{baseUrl}}/moderation/revisions/{{revisionId}}/reject",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "moderation",
                "revisions",
                "{{revisionId}}",
                "reject"
              ]
            },
            "description": "Rejette la révision (motif obligatoire). Le pointeur public reste inchangé."
          }
        }
      ]
    },
    {
      "name": "Quartiers",
      "item": [
        {
          "name": "List active quartiers",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/quartiers",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "quartiers"
              ]
            },
            "description": "Liste publique des quartiers actifs (id, name, prefix)."
          }
        }
      ]
    }
  ],
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:3000/api"
    },
    {
      "key": "addressCode",
      "value": ""
    },
    {
      "key": "revisionId",
      "value": ""
    }
  ]
}
