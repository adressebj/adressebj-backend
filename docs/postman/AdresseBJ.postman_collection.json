{
 "info": {
  "_postman_id": "91a8c9b3-6cf4-4cad-ae7f-ffda05300a94",
  "name": "AdresseBJ — Backend API",
  "description": "Collection vivante de l'API AdresseBJ. À maintenir en synchro stricte avec l'API réelle (cf. docs/API_POSTMAN.md). Variables d'environnement : baseUrl, jwt, jwtMod, apiKey. Variables de collection : addressCode, revisionId (auto-capturées).",
  "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
 },
 "item": [
  {
   "name": "Auth",
   "item": [
    {
     "name": "Request OTP",
     "request": {
      "method": "POST",
      "header": [
       {
        "key": "Content-Type",
        "value": "application/json"
       }
      ],
      "body": {
       "mode": "raw",
       "raw": "{\n  \"phone\": \"+22990000000\"\n}",
       "options": {
        "raw": {
         "language": "json"
        }
       }
      },
      "url": {
       "raw": "{{baseUrl}}/auth/request-otp",
       "host": [
        "{{baseUrl}}"
       ],
       "path": [
        "auth",
        "request-otp"
       ]
      },
      "description": "Envoie un OTP au numéro (provider dev : code visible dans les logs serveur)."
     }
    },
    {
     "name": "Register",
     "request": {
      "method": "POST",
      "header": [
       {
        "key": "Content-Type",
        "value": "application/json"
       }
      ],
      "body": {
       "mode": "raw",
       "raw": "{\n  \"phone\": \"+22990000000\",\n  \"code\": \"123456\",\n  \"email\": \"habitant@example.com\",\n  \"password\": \"motdepasse123\"\n}",
       "options": {
        "raw": {
         "language": "json"
        }
       }
      },
      "url": {
       "raw": "{{baseUrl}}/auth/register",
       "host": [
        "{{baseUrl}}"
       ],
       "path": [
        "auth",
        "register"
       ]
      },
      "description": "Crée l'habitant après vérification de l'OTP. Capture {{jwt}}."
     },
     "event": [
      {
       "listen": "test",
       "script": {
        "type": "text/javascript",
        "exec": [
         "const d = pm.response.json().data;",
         "if (d && d.token) pm.environment.set('jwt', d.token);",
         "pm.test('token reçu', () => pm.expect(d.token).to.be.a('string'));"
        ]
       }
      }
     ]
    },
