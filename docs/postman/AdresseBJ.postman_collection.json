    },
    {
     "name": "Public page",
     "request": {
      "method": "GET",
      "header": [],
      "url": {
       "raw": "{{baseUrl}}/addresses/{{addressCode}}",
       "host": [
        "{{baseUrl}}"
       ],
       "path": [
        "addresses",
        "{{addressCode}}"
       ]
      },
