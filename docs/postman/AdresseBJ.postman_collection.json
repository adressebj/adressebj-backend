         "language": "json"
        }
       }
      },
      "url": {
       "raw": "{{baseUrl}}/auth/account",
       "host": [
        "{{baseUrl}}"
       ],
       "path": [
        "auth",
        "account"
       ]
      },
      "description": "Suppression de compte = anonymisation immédiate (pierre tombale). Le numéro doit correspondre au compte (400 PHONE_MISMATCH sinon). Adresses désactivées, données perso purgées, ratings/reports/contributions conservés. Le JWT devient invalide."
