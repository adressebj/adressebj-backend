      ]
    },
    {
      "name": "Addresses",
      "item": [
        {
          "name": "Create address",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"category\": \"COMMERCE\",\n  \"steps\": [\n    \"Partir du carrefour\",\n    \"Boutique verte\"\n  ],\n  \"photoUrl\": \"https://res.cloudinary.com/demo/image/upload/sample.jpg\",\n  \"gpsLat\": 6.4001,\n  \"gpsLng\": 2.4001\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{jwt}}",
                  "type": "string"
                }
              ]
            },
            "url": {
              "raw": "{{baseUrl}}/addresses",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "addresses"
              ]
            },
            "description": "localisationId résolu côté serveur (jamais envoyé par le client). Capture {{addressCode}}."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const d = pm.response.json().data;",
                  "if (d && d.code) pm.collectionVariables.set('addressCode', d.code);",
                  "pm.test('révision n°1 en attente', () => pm.expect(d.revisionStatus).to.eql('EN_ATTENTE_VALIDATION'));"
                ]
              }
            }
          ]
        },
        {
          "name": "My addresses",
          "request": {
            "method": "GET",
            "header": [],
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{jwt}}",
                  "type": "string"
                }
              ]
            },
            "url": {
              "raw": "{{baseUrl}}/addresses/mine",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "addresses",
                "mine"
              ]
            },
            "description": "Liste les adresses de l'habitant connecté + leur état (published, statut de révision)."
          }
        },
        {
          "name": "Rate address",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"stars\": 4\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{jwt}}",
                  "type": "string"
                }
              ]
            },
            "url": {
              "raw": "{{baseUrl}}/addresses/{{addressCode}}/rate",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "addresses",
                "{{addressCode}}",
                "rate"
              ]
            },
            "description": "Évaluation 1–5 (upsert sur l'habitant). Renvoie la moyenne recalculée. 400 INVALID_RATING hors bornes, 404 si non publiée."
          }
        },
        {
          "name": "Report address",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"message\": \"La maison a été démolie.\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{jwt}}",
                  "type": "string"
                }
              ]
            },
            "url": {
              "raw": "{{baseUrl}}/addresses/{{addressCode}}/report",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "addresses",
                "{{addressCode}}",
                "report"
              ]
            },
            "description": "Signalement (message facultatif). 201 {reportId,status:PENDING}. 404/410 selon l'état."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const d=pm.response.json().data;",
                  "if(d&&d.reportId)pm.collectionVariables.set('reportId',d.reportId);"
                ]
              }
            }
          ]
        },
        {
          "name": "Submit contribution",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"message\": \"Sens unique le matin, entrer par le nord.\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{jwt}}",
                  "type": "string"
                }
              ]
            },
            "url": {
              "raw": "{{baseUrl}}/addresses/{{addressCode}}/contribution",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "addresses",
                "{{addressCode}}",
                "contribution"
              ]
            },
            "description": "Contribution terrain (requise, non vide). 201 {contributionId,status:PENDING}. 400 CONTRIBUTION_MESSAGE_REQUIRED."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const d=pm.response.json().data;",
                  "if(d&&d.contributionId)pm.collectionVariables.set('contributionId',d.contributionId);"
                ]
              }
            }
          ]
        },
        {
          "name": "Update address",
          "request": {
            "method": "PATCH",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{jwt}}",
                  "type": "string"
                }
              ]
            },
            "url": {
              "raw": "{{baseUrl}}/addresses/{{addressCode}}",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "addresses",
                "{{addressCode}}"
              ]
            },
            "description": "Nouvelle version (catégorie/étapes/photo ; GPS non modifiable) → révision EN_ATTENTE. Public garde l'ancienne version. 409 REVISION_ALREADY_PENDING si une modif est déjà en attente.",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"category\": \"COMMERCE\",\n  \"steps\": [\n    \"Nouveau repère\",\n    \"Portail vert\"\n  ],\n  \"photoUrl\": \"https://example.com/new.jpg\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          }
        },
        {
          "name": "Toggle discoverable",
          "request": {
            "method": "PATCH",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{jwt}}",
                  "type": "string"
                }
              ]
            },
            "url": {
              "raw": "{{baseUrl}}/addresses/{{addressCode}}/discoverable",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "addresses",
                "{{addressCode}}",
                "discoverable"
              ]
            },
            "description": "Bascule mapDiscoverable (retire/ajoute l'adresse de la carte browsable).",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"discoverable\": false\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          }
        },
        {
          "name": "Deactivate address",
          "request": {
            "method": "DELETE",
            "header": [],
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{jwt}}",
                  "type": "string"
                }
              ]
            },
            "url": {
              "raw": "{{baseUrl}}/addresses/{{addressCode}}",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "addresses",
                "{{addressCode}}"
              ]
            },
            "description": "Désactivation définitive par le propriétaire → 410 ensuite. 409 si déjà désactivée."
          }
        },
        {
          "name": "Public page",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/addresses/{{addressCode}}",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "addresses",
                "{{addressCode}}"
              ]
            },
            "description": "Public, sans auth. 200 si publiée, 404 si jamais publiée/inexistante, 410 si désactivée."
          }
        },
        {
          "name": "Resolve (clé API)",
          "request": {
            "method": "GET",
            "header": [],
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{apiKey}}",
                  "type": "string"
                }
              ]
            },
            "url": {
              "raw": "{{baseUrl}}/addresses/{{addressCode}}/resolve",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "addresses",
                "{{addressCode}}",
                "resolve"
              ]
            },
            "description": "Header Authorization: Bearer {{apiKey}} (bj_live_…). Résolution complète + métering. 401 si clé absente/invalide/révoquée/expirée."
          }
        },
        {
          "name": "Verify (clé API)",
          "request": {
            "method": "GET",
            "header": [],
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{apiKey}}",
                  "type": "string"
                }
              ]
            },
            "url": {
              "raw": "{{baseUrl}}/addresses/{{addressCode}}/verify",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "addresses",
                "{{addressCode}}",
                "verify"
              ]
            },
            "description": "Moyenne /5 + nombre d'évaluations + published (clé API, météré VERIFY). averageRating null = aucune évaluation."
          }
        },
        {
          "name": "ETA (clé API)",
          "request": {
            "method": "GET",
            "header": [],
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{apiKey}}",
                  "type": "string"
                }
              ]
            },
            "url": {
              "raw": "{{baseUrl}}/addresses/{{addressCode}}/eta?fromLat=6.3600&fromLng=2.4100",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "addresses",
                "{{addressCode}}",
                "eta"
              ],
              "query": [
                {
                  "key": "fromLat",
                  "value": "6.3600"
                },
                {
                  "key": "fromLng",
                  "value": "2.4100"
                }
              ]
            },
            "description": "Estimation ETA depuis une origine (fromLat/fromLng) vers l'adresse (clé API, météré ETA). Réponse: { code, origin, destination, etaMinutes, distanceMeters, source }. source=OSRM (routage réel) ou ESTIMATE (repli local gracieux). 400 si origine manquante/hors bornes, 404/410 comme resolve, 401 si clé invalide."
          }
        }
      ]
    },
    {
      "name": "Moderation",
      "item": [
        {
          "name": "List pending revisions",
          "request": {
            "method": "GET",
            "header": [],
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{jwtMod}}",
                  "type": "string"
                }
              ]
            },
            "url": {
              "raw": "{{baseUrl}}/moderation/revisions",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "moderation",
                "revisions"
              ]
            },
            "description": "File des révisions EN_ATTENTE_VALIDATION (Mod/Admin). Capture {{revisionId}} (1re entrée)."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const d = pm.response.json().data;",
                  "if (Array.isArray(d) && d.length) pm.collectionVariables.set('revisionId', d[0].id);"
                ]
              }
            }
          ]
        },
        {
          "name": "Approve revision",
          "request": {
            "method": "PATCH",
            "header": [],
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{jwtMod}}",
                  "type": "string"
                }
              ]
            },
            "url": {
              "raw": "{{baseUrl}}/moderation/revisions/{{revisionId}}/approve",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "moderation",
                "revisions",
                "{{revisionId}}",
                "approve"
              ]
            },
            "description": "Publie la révision et bascule le pointeur. L'ancienne version publiée passe ARCHIVEE."
          }
        },
        {
          "name": "Reject revision",
          "request": {
            "method": "PATCH",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"reason\": \"Photo illisible\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{jwtMod}}",
                  "type": "string"
                }
              ]
            },
            "url": {
              "raw": "{{baseUrl}}/moderation/revisions/{{revisionId}}/reject",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "moderation",
                "revisions",
                "{{revisionId}}",
                "reject"
              ]
            },
            "description": "Rejette la révision (motif obligatoire). Le pointeur public reste inchangé."
          }
        },
        {
          "name": "List reports",
          "request": {
            "method": "GET",
            "header": [],
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
