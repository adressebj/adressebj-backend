    {
     "name": "Delete account (anonymisation)",
     "request": {
      "method": "DELETE",
      "header": [
       {
        "key": "Content-Type",
        "value": "application/json"
       }
      ],
      "auth": {
       "type": "bearer",
       "bearer": [
        {
         "key": "token",
         "value": "{{jwt}}",
