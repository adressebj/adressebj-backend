-- ============================================================
-- ENUMERATIONS
-- ============================================================

CREATE TYPE statut_compte AS ENUM ('ACTIF', 'SUSPENDU', 'SUPPRIME');
CREATE TYPE statut_adresse AS ENUM ('ACTIVE', 'INACTIVE');
CREATE TYPE statut_cle AS ENUM ('ACTIVE', 'REVOKED', 'EXPIREE');
CREATE TYPE statut_visite AS ENUM ('EN_COURS', 'CONFIRMEE', 'ABANDONNEE');
CREATE TYPE statut_signalement AS ENUM ('EN_ATTENTE', 'TRAITE', 'REJETE');
CREATE TYPE statut_contribution AS ENUM ('EN_ATTENTE', 'VALIDEE', 'REJETEE');
CREATE TYPE type_eval AS ENUM ('CONFORME', 'NON_CONFORME');
CREATE TYPE source_eval AS ENUM ('VISITEUR', 'VISITE');
CREATE TYPE source_visite AS ENUM ('APP_NATIVE', 'API_TIERCE');
CREATE TYPE type_notification AS ENUM ('SCORE_DEGRADE', 'DESACTIVATION', 'INFO');

-- ============================================================
-- UTILISATEUR (table mère, héritage par table concrète)
-- ============================================================

CREATE TABLE utilisateur (
    id                UUID        PRIMARY KEY DEFAULT gen_random_uuid(),
    telephone         TEXT        NOT NULL UNIQUE,
    otp_verifie       BOOLEAN     NOT NULL DEFAULT FALSE,
    date_inscription  TIMESTAMPTZ NOT NULL DEFAULT now(),
    statut            statut_compte NOT NULL DEFAULT 'ACTIF',
    type_utilisateur  TEXT        NOT NULL  -- discriminant : 'habitant' | 'administrateur' | 'developpeur_tiers'
);

-- ============================================================
-- HABITANT
-- ============================================================

CREATE TABLE habitant (
    id                    UUID    PRIMARY KEY REFERENCES utilisateur(id) ON DELETE CASCADE,
    email                 TEXT    NOT NULL UNIQUE,
    consentement_public   BOOLEAN NOT NULL DEFAULT FALSE
);

-- ============================================================
-- ADMINISTRATEUR
-- ============================================================

CREATE TABLE administrateur (
    id            UUID    PRIMARY KEY REFERENCES utilisateur(id) ON DELETE CASCADE,
    niveau_acces  INTEGER NOT NULL DEFAULT 1
);

-- ============================================================
-- DEVELOPPEUR TIERS
-- ============================================================

CREATE TABLE developpeur_tiers (
    id            UUID  PRIMARY KEY REFERENCES utilisateur(id) ON DELETE CASCADE,
    nom_entreprise TEXT NOT NULL,
    secteur        TEXT,
    contact        TEXT
);

-- ============================================================
-- OTP
-- ============================================================

CREATE TABLE otp (
    id              UUID        PRIMARY KEY DEFAULT gen_random_uuid(),
    utilisateur_id  UUID        NOT NULL REFERENCES utilisateur(id) ON DELETE CASCADE,
    code            TEXT        NOT NULL,
    expiration      TIMESTAMPTZ NOT NULL,
    utilise         BOOLEAN     NOT NULL DEFAULT FALSE
);

-- ============================================================
-- ZONE
-- ============================================================

CREATE TABLE zone (
    id          UUID    PRIMARY KEY DEFAULT gen_random_uuid(),
    nom         TEXT    NOT NULL,
    commune     TEXT    NOT NULL,
    prefixe     TEXT,
    perimetre   JSONB   NOT NULL,   -- GeoJSON
    active      BOOLEAN NOT NULL DEFAULT TRUE,
    source_osm  BOOLEAN NOT NULL DEFAULT FALSE
);

-- ============================================================
-- ADRESSE
-- ============================================================

CREATE TABLE adresse (
    id                UUID          PRIMARY KEY DEFAULT gen_random_uuid(),
    habitant_id       UUID          NOT NULL REFERENCES habitant(id) ON DELETE CASCADE,
    zone_id           UUID          NOT NULL REFERENCES zone(id),
    code_adresse      TEXT          NOT NULL UNIQUE,
    latitude          DOUBLE PRECISION NOT NULL,
    longitude         DOUBLE PRECISION NOT NULL,
    statut            statut_adresse NOT NULL DEFAULT 'ACTIVE',
    date_creation     TIMESTAMPTZ   NOT NULL DEFAULT now(),
    date_modification TIMESTAMPTZ   NOT NULL DEFAULT now()
);

-- ============================================================
-- INSTRUCTION ACCES  (composition 1-1 avec adresse)
-- ============================================================

CREATE TABLE instruction_acces (
    adresse_id      UUID    PRIMARY KEY REFERENCES adresse(id) ON DELETE CASCADE,
    steps           TEXT[]  NOT NULL DEFAULT '{}',
    assembled_text  TEXT
);

-- ============================================================
-- PHOTO
-- ============================================================

CREATE TABLE photo (
    id              UUID        PRIMARY KEY DEFAULT gen_random_uuid(),
    adresse_id      UUID        NOT NULL REFERENCES adresse(id) ON DELETE CASCADE,
    url_cloudinary  TEXT        NOT NULL,
    taille          INTEGER     NOT NULL,  -- octets
    date_upload     TIMESTAMPTZ NOT NULL DEFAULT now()
);

-- ============================================================
-- CLE API
-- ============================================================

CREATE TABLE cle_api (
    id                UUID       PRIMARY KEY DEFAULT gen_random_uuid(),
    developpeur_id    UUID       NOT NULL REFERENCES developpeur_tiers(id) ON DELETE CASCADE,
    valeur            TEXT       NOT NULL UNIQUE,
    date_emission     TIMESTAMPTZ NOT NULL DEFAULT now(),
    date_expiration   TIMESTAMPTZ,
    statut            statut_cle  NOT NULL DEFAULT 'ACTIVE',
    ratio_remontee    DOUBLE PRECISION NOT NULL DEFAULT 0
);

-- ============================================================
-- VISITE
-- ============================================================

CREATE TABLE visite (
    id                   UUID          PRIMARY KEY DEFAULT gen_random_uuid(),
    adresse_id           UUID          NOT NULL REFERENCES adresse(id) ON DELETE CASCADE,
    cle_api_id           UUID          REFERENCES cle_api(id) ON DELETE SET NULL,
    horodatage_depart    TIMESTAMPTZ   NOT NULL,
    horodatage_arrivee   TIMESTAMPTZ,
    prix_final           DOUBLE PRECISION,
    corridor_osrm        TEXT,
    statut               statut_visite NOT NULL DEFAULT 'EN_COURS',
    source               source_visite NOT NULL
);

-- ============================================================
-- EVALUATION
-- ============================================================

CREATE TABLE evaluation (
    id              UUID        PRIMARY KEY DEFAULT gen_random_uuid(),
    adresse_id      UUID        NOT NULL REFERENCES adresse(id) ON DELETE CASCADE,
    visite_id       UUID        REFERENCES visite(id) ON DELETE SET NULL,
    type            type_eval   NOT NULL,
    date            TIMESTAMPTZ NOT NULL DEFAULT now(),
    source          source_eval NOT NULL,
    hash_anti_abus  TEXT        NOT NULL
);

-- ============================================================
-- SIGNALEMENT
-- ============================================================

CREATE TABLE signalement (
    id          UUID               PRIMARY KEY DEFAULT gen_random_uuid(),
    adresse_id  UUID               NOT NULL REFERENCES adresse(id) ON DELETE CASCADE,
    motif       TEXT               NOT NULL,
    hash_auteur TEXT               NOT NULL,
    date        TIMESTAMPTZ        NOT NULL DEFAULT now(),
    statut      statut_signalement NOT NULL DEFAULT 'EN_ATTENTE'
);

-- ============================================================
-- CONTRIBUTION TERRAIN
-- ============================================================

CREATE TABLE contribution_terrain (
    id          UUID                PRIMARY KEY DEFAULT gen_random_uuid(),
    adresse_id  UUID                NOT NULL REFERENCES adresse(id) ON DELETE CASCADE,
    contenu     TEXT                NOT NULL,
    hash_auteur TEXT                NOT NULL,
    statut      statut_contribution NOT NULL DEFAULT 'EN_ATTENTE'
);

-- ============================================================
-- NOTIFICATION
-- ============================================================

CREATE TABLE notification (
    id          UUID              PRIMARY KEY DEFAULT gen_random_uuid(),
    habitant_id UUID              NOT NULL REFERENCES habitant(id) ON DELETE CASCADE,
    adresse_id  UUID              REFERENCES adresse(id) ON DELETE SET NULL,
    message     TEXT              NOT NULL,
    type        type_notification NOT NULL,
    lue         BOOLEAN           NOT NULL DEFAULT FALSE,
    date_envoi  TIMESTAMPTZ       NOT NULL DEFAULT now()
);

-- ============================================================
-- INDEX
-- ============================================================

CREATE INDEX idx_otp_utilisateur        ON otp(utilisateur_id);
CREATE INDEX idx_adresse_habitant       ON adresse(habitant_id);
CREATE INDEX idx_adresse_zone           ON adresse(zone_id);
CREATE INDEX idx_photo_adresse          ON photo(adresse_id);
CREATE INDEX idx_cle_api_developpeur    ON cle_api(developpeur_id);
CREATE INDEX idx_visite_adresse         ON visite(adresse_id);
CREATE INDEX idx_visite_cle_api         ON visite(cle_api_id);
CREATE INDEX idx_evaluation_adresse     ON evaluation(adresse_id);
CREATE INDEX idx_evaluation_visite      ON evaluation(visite_id);
CREATE INDEX idx_signalement_adresse    ON signalement(adresse_id);
CREATE INDEX idx_contribution_adresse   ON contribution_terrain(adresse_id);
CREATE INDEX idx_notification_habitant  ON notification(habitant_id);
CREATE INDEX idx_notification_adresse   ON notification(adresse_id);
